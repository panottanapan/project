<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- Header Navbar -->
    <%- include('../partials/navbar') %>

    <!-- STEPPER HEADER BAR (3 Main Steps) -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm py-4 px-4 sm:px-6">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2 sm:gap-6 text-xs font-extrabold w-full justify-around sm:justify-start">
                
                <!-- Step 1 Indicator -->
                <div id="stepHeader1" class="flex items-center gap-2 text-blue-600 border-b-2 border-blue-600 pb-1 cursor-pointer" onclick="switchStep(1)">
                    <span class="w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center text-[11px]">1</span>
                    <span>Fill in your info</span>
                </div>
                <span class="text-slate-300">➔</span>

                <!-- Step 2 Indicator -->
                <div id="stepHeader2" class="flex items-center gap-2 text-slate-400 pb-1 cursor-pointer" onclick="switchStep(2)">
                    <span class="w-6 h-6 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[11px]">2</span>
                    <span>Choose your seat</span>
                </div>
                <span class="text-slate-300">➔</span>

                <!-- Step 3 Indicator -->
                <div id="stepHeader3" class="flex items-center gap-2 text-slate-400 pb-1 cursor-pointer" onclick="switchStep(3)">
                    <span class="w-6 h-6 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[11px]">3</span>
                    <span>Finalize payment</span>
                </div>

            </div>

            <div class="hidden md:flex items-center gap-2 text-xs text-slate-500 font-semibold">
                <span>🎧 24/7 Customer Support</span>
            </div>
        </div>
    </nav>

    <!-- MAIN BOOKING CONTAINER -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full flex-grow">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            <!-- LEFT FORM COLUMN (Step 1, 2, 3 Views) -->
            <div class="lg:col-span-8 space-y-6">

                <!-- ================================================================= -->
                <!-- STEP 1: FILL IN YOUR INFO (รายละเอียดผู้โดยสาร & สิทธิประโยชน์)    -->
                <!-- ================================================================= -->
                <div id="stepSection1" class="space-y-6">
                    
                    <!-- Flight Detail Summary Card -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-3">
                        <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                            <h1 class="text-xl font-extrabold text-slate-900">Trip to <%= bookingInfo.destination.split(' ')[0] %></h1>
                            <a href="/flights/search" class="text-xs text-blue-600 font-bold hover:underline">Change flight ✎</a>
                        </div>

                        <div class="space-y-2 text-xs">
                            <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl">
                                <div class="flex items-center gap-2">
                                    <span class="text-amber-500">🟡</span>
                                    <span class="font-extrabold text-slate-900"><%= bookingInfo.origin %> ➔ <%= bookingInfo.destination %></span>
                                </div>
                                <span class="text-slate-500"><%= bookingInfo.outboundTime %></span>
                            </div>
                            <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl">
                                <div class="flex items-center gap-2">
                                    <span class="text-amber-500">🟡</span>
                                    <span class="font-extrabold text-slate-900"><%= bookingInfo.destination %> ➔ <%= bookingInfo.origin %></span>
                                </div>
                                <span class="text-slate-500"><%= bookingInfo.returnTime %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Who's traveling? (Passenger Info Form) -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
                        <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                            <div>
                                <h2 class="text-base font-extrabold text-slate-900">Who's traveling?</h2>
                                <p class="text-[11px] text-slate-500">Names must match ID exactly as shown on official documents</p>
                            </div>
                            <span class="text-xs text-blue-600 font-bold">✔ Sign in for effortless booking</span>
                        </div>

                        <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-amber-900 text-[11px] font-medium leading-relaxed">
                            <strong>Notice:</strong> Please make sure passenger names match valid passport/ID for airport check-in.
                        </div>

                        <% passengers.forEach((passenger, index) => { %>
                            <div class="border border-slate-200 rounded-xl p-4 space-y-4 bg-slate-50/50">
                                <span class="font-extrabold text-xs text-slate-900 block border-b border-slate-200 pb-2">Passenger <%= index + 1 %>: <%= passenger.typeLabel %></span>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <div>
                                        <label for="passengerFirstName<%= index + 1 %>" class="block text-[10px] font-bold text-slate-500 mb-1">Given names *</label>
                                        <input type="text" id="passengerFirstName<%= index + 1 %>" name="passengers[<%= index %>][firstName]" placeholder="e.g. John" class="w-full border border-slate-300 rounded-xl p-2.5 text-xs outline-none focus:border-blue-500 bg-white font-medium">
                                    </div>
                                    <div>
                                        <label for="passengerLastName<%= index + 1 %>" class="block text-[10px] font-bold text-slate-500 mb-1">Last name (surname) *</label>
                                        <input type="text" id="passengerLastName<%= index + 1 %>" name="passengers[<%= index %>][lastName]" placeholder="e.g. Doe" class="w-full border border-slate-300 rounded-xl p-2.5 text-xs outline-none focus:border-blue-500 bg-white font-medium">
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                    <div>
                                        <label for="passengerGender<%= index + 1 %>" class="block text-[10px] font-bold text-slate-500 mb-1">Gender *</label>
                                        <select id="passengerGender<%= index + 1 %>" name="passengers[<%= index %>][gender]" class="w-full border border-slate-300 rounded-xl p-2.5 text-xs outline-none focus:border-blue-500 bg-white font-medium">
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="passengerDateOfBirth<%= index + 1 %>" class="block text-[10px] font-bold text-slate-500 mb-1">Date of birth *</label>
                                        <input type="date" id="passengerDateOfBirth<%= index + 1 %>" name="passengers[<%= index %>][dateOfBirth]" class="w-full border border-slate-300 rounded-xl p-2.5 text-xs outline-none focus:border-blue-500 bg-white font-medium">
                                    </div>
                                    <div>
                                        <label for="passengerNationality<%= index + 1 %>" class="block text-[10px] font-bold text-slate-500 mb-1">Nationality *</label>
                                        <select id="passengerNationality<%= index + 1 %>" name="passengers[<%= index %>][nationality]" class="w-full border border-slate-300 rounded-xl p-2.5 text-xs outline-none focus:border-blue-500 bg-white font-medium">
                                            <option value="Thailand">Thailand</option>
                                            <option value="Singapore">Singapore</option>
                                            <option value="United States">United States</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <!-- Contact Details Form -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
                        <h2 class="text-base font-extrabold text-slate-900 border-b border-slate-100 pb-3">Contact details</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Contact name *</label>
                                <input type="text" placeholder="Full Name" value="John Doe" class="w-full border border-slate-300 rounded-xl p-2.5 text-xs outline-none focus:border-blue-500 font-medium">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Email *</label>
                                <input type="email" placeholder="email@example.com" value="john.doe@example.com" class="w-full border border-slate-300 rounded-xl p-2.5 text-xs outline-none focus:border-blue-500 font-medium">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Mobile phone *</label>
                                <div class="flex gap-1">
                                    <span class="bg-slate-100 border border-slate-300 rounded-xl px-2.5 py-2.5 text-xs font-bold text-slate-600">+66</span>
                                    <input type="tel" placeholder="812345678" value="812345678" class="w-full border border-slate-300 rounded-xl p-2.5 text-xs outline-none focus:border-blue-500 font-medium">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Baggage Allowance Card -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
                        <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                            <h2 class="text-base font-extrabold text-slate-900">Baggage allowance</h2>
                            <span class="text-xs text-emerald-600 font-bold">✔ Save by adding allowance now</span>
                        </div>

                        <div class="grid grid-cols-3 gap-2 text-center text-xs pb-3 border-b border-slate-100">
                            <div class="p-2 bg-slate-50 rounded-xl">
                                <span class="text-lg block">🎒</span>
                                <span class="font-bold text-slate-900 block">Personal item</span>
                                <span class="text-[10px] text-slate-400">Included (Free)</span>
                            </div>
                            <div class="p-2 bg-slate-50 rounded-xl">
                                <span class="text-lg block">🧳</span>
                                <span class="font-bold text-slate-900 block">Carry-on baggage</span>
                                <span class="text-[10px] text-slate-400">7 kg Included</span>
                            </div>
                            <div class="p-2 bg-slate-50 rounded-xl border border-amber-200 bg-amber-50/40">
                                <span class="text-lg block">🧳❗</span>
                                <span class="font-bold text-amber-900 block">Checked baggage</span>
                                <span class="text-[10px] text-amber-700 font-bold">Not included</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center text-xs pt-1">
                            <div>
                                <p class="font-bold text-slate-900">Add 15 kg Checked Baggage</p>
                                <p class="text-[10px] text-slate-400">For Outbound & Return flights</p>
                            </div>
                            <button id="baggageToggleBtn" onclick="toggleBaggageAddon()" <%= bookingInfo.baggageIncluded ? 'disabled' : '' %> class="px-4 py-2 bg-blue-50 text-blue-600 font-bold rounded-xl border border-blue-200 hover:bg-blue-600 hover:text-white transition disabled:cursor-not-allowed disabled:opacity-60">
                                <%= bookingInfo.baggageIncluded ? 'Included in fare' : '+ Add ฿450' %>
                            </button>
                        </div>
                    </div>

                    <!-- Hotel Savings & Perks Card -->
                    <div class="bg-gradient-to-r from-rose-50 via-white to-amber-50 rounded-2xl border border-rose-200 p-5 shadow-sm space-y-4">
                        <div class="flex justify-between items-center">
                            <h2 class="text-base font-extrabold text-slate-900">Book this flight & unlock more perks ✈️</h2>
                            <span class="bg-rose-600 text-white text-[10px] font-extrabold px-2.5 py-0.5 rounded">Flyer Exclusive</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center text-xs">
                            <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm space-y-1">
                                <span class="text-xl">🏨</span>
                                <p class="font-black text-slate-900">Up to 25% off</p>
                                <p class="text-[10px] text-slate-500">Hotel exclusive deal</p>
                            </div>
                            <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm space-y-1">
                                <span class="text-xl">🎟️</span>
                                <p class="font-black text-slate-900">Up to ฿ 200 off</p>
                                <p class="text-[10px] text-slate-500">New user promo code</p>
                            </div>
                            <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm space-y-1">
                                <span class="text-xl">⚡</span>
                                <p class="font-black text-slate-900">Free hotel cancel</p>
                                <p class="text-[10px] text-slate-500">If flight rescheduled</p>
                            </div>
                        </div>
                    </div>

                    <!-- Promo Code Input Card -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex items-center justify-between gap-4">
                        <span class="font-extrabold text-xs text-slate-900">Promo codes</span>
                        <div class="flex gap-2 w-1/2">
                            <input type="text" id="promoInput" placeholder="Enter promo code" class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs outline-none">
                            <button onclick="applyPromoCode()" class="bg-slate-900 text-white text-xs font-bold px-4 py-2 rounded-xl hover:bg-slate-800">Apply</button>
                        </div>
                    </div>

                    <button onclick="switchStep(2)" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-extrabold py-4 rounded-2xl shadow-lg transition text-sm">
                        Continue to Seat Selection ➔
                    </button>
                </div>

                <!-- ================================================================= -->
                <!-- STEP 2: CHOOSE YOUR SEAT (เลือกผังที่นั่งบนเครื่องบิน)              -->
                <!-- ================================================================= -->
                <div id="stepSection2" class="hidden space-y-6">
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6">
                        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 border-b border-slate-100 pb-4">
                            <div>
                                <h2 class="text-xl font-extrabold text-slate-900">Select Seats for Bangkok ⇌ Chiang Mai</h2>
                                <p class="text-xs text-slate-500">Choose one seat for each adult and child traveling</p>
                            </div>
                            <span class="bg-blue-50 text-blue-600 font-extrabold text-xs px-3 py-1 rounded-full border border-blue-200 whitespace-nowrap">
                                Seats: <strong id="selectedSeatBadge">0 / <%= passengers.filter(passenger => passenger.seatRequired).length %></strong>
                            </span>
                        </div>

                        <!-- Seat Legend -->
                        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs font-bold text-slate-600 bg-slate-50 p-3 rounded-xl">
                            <div class="flex items-center gap-1.5"><span class="w-4 h-4 bg-slate-200 rounded"></span> Standard (Free)</div>
                            <div class="flex items-center gap-1.5"><span class="w-4 h-4 bg-emerald-500 rounded"></span> Front / Extra Legroom (+฿250)</div>
                            <div class="flex items-center gap-1.5"><span class="w-4 h-4 bg-blue-600 rounded"></span> Selected</div>
                            <div class="flex items-center gap-1.5"><span class="w-4 h-4 bg-slate-400 rounded"></span> Occupied</div>
                        </div>

                        <!-- Airplane Cabin Visual Grid -->
                        <div class="overflow-x-auto pb-2">
                            <div class="min-w-[420px] max-w-2xl mx-auto bg-slate-100 border-2 border-slate-300 rounded-t-[10rem] p-5 sm:p-8 space-y-4 shadow-inner">
                                <p class="text-center font-black text-xs text-slate-400 tracking-widest uppercase">Cockpit / Front</p>
                                <div class="grid grid-cols-[repeat(3,minmax(0,1fr))_1.5rem_repeat(3,minmax(0,1fr))] gap-2 text-center text-xs font-bold text-slate-400">
                                    <span>A</span><span>B</span><span>C</span><span></span><span>D</span><span>E</span><span>F</span>
                                </div>
                                <div id="seatRows" class="space-y-2"></div>
                            </div>
                        </div>
                        <p id="seatSelectionMessage" role="status" aria-live="polite" class="text-center text-xs font-semibold text-slate-500"></p>
                        <p class="text-center text-[11px] text-slate-500">Lap infants travel on an adult's lap and do not need a separate seat.</p>

                        <div class="flex justify-between items-center pt-4">
                            <button onclick="switchStep(1)" class="px-6 py-3 bg-slate-100 hover:bg-slate-200 font-bold text-xs text-slate-700 rounded-xl">
                                🔓 Back to Info
                            </button>
                            <button id="continueToPaymentBtn" onclick="switchStep(3)" disabled class="px-8 py-3 bg-blue-600 hover:bg-blue-700 disabled:opacity-40 disabled:cursor-not-allowed font-bold text-xs text-white rounded-xl shadow-md">
                                Confirm & Continue to Payment ➔
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ================================================================= -->
                <!-- STEP 3: FINALIZE YOUR PAYMENT (การชำระเงิน + Eco Offset)           -->
                <!-- ================================================================= -->
                <div id="stepSection3" class="hidden space-y-6">
                    
                    <!-- Eco Carbon Offset Badge -->
                    <div class="bg-gradient-to-r from-emerald-800 to-teal-900 text-white rounded-2xl p-5 shadow-sm space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="bg-emerald-500 text-white text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase">
                                🌱 Green Choice
                            </span>
                            <span class="text-xs text-emerald-200 font-bold">Verified Google TIM Standard</span>
                        </div>
                        <h2 class="text-lg font-extrabold text-white">Make this trip 100% Carbon Neutral</h2>
                        <p class="text-xs text-emerald-100 leading-relaxed">
                            Contribute ฿50 to Thailand Reforestation & Sustainable Aviation Projects to neutralize remaining CO₂ emissions.
                        </p>
                        <label class="flex items-center gap-2 cursor-pointer pt-1">
                            <input type="checkbox" id="carbonOffsetCheck" onchange="toggleCarbonOffset()" class="w-4 h-4 rounded text-emerald-500 focus:ring-0">
                            <span class="text-xs font-bold text-white">Add ฿50 for Green Travel Tree Planting</span>
                        </label>
                    </div>

                    <!-- Payment Methods Selection Card -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6">
                        <h2 class="text-lg font-extrabold text-slate-900 border-b border-slate-100 pb-3">Payment method</h2>

                        <div class="space-y-3">
                            <!-- Credit Card Option -->
                            <label class="flex items-start gap-3 p-4 border border-blue-500 bg-blue-50/30 rounded-2xl cursor-pointer">
                                <input type="radio" name="paymentMethod" value="card" checked class="mt-1 accent-blue-600">
                                <div class="space-y-2 w-full">
                                    <div class="flex justify-between items-center">
                                        <span class="font-extrabold text-xs text-slate-900">Credit or Debit Card</span>
                                        <span class="text-xs">💳 Visa / Mastercard / JCB</span>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                                        <input type="text" placeholder="Card Number" value="4111 2222 3333 4444" class="w-full border border-slate-300 rounded-xl p-2.5 text-xs bg-white outline-none">
                                        <div class="flex gap-2">
                                            <input type="text" placeholder="MM/YY" value="12/28" class="w-1/2 border border-slate-300 rounded-xl p-2.5 text-xs bg-white outline-none">
                                            <input type="text" placeholder="CVV" value="123" class="w-1/2 border border-slate-300 rounded-xl p-2.5 text-xs bg-white outline-none">
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <!-- PromptPay QR Option -->
                            <label class="flex items-center justify-between p-4 border border-slate-200 hover:border-blue-500 rounded-2xl cursor-pointer transition">
                                <div class="flex items-center gap-3">
                                    <input type="radio" name="paymentMethod" value="promptpay" class="accent-blue-600">
                                    <span class="font-extrabold text-xs text-slate-900">PromptPay QR Code</span>
                                </div>
                                <span class="text-xs text-slate-500 font-bold">📲 Instant Scan</span>
                            </label>

                            <!-- TrueMoney / E-Wallet -->
                            <label class="flex items-center justify-between p-4 border border-slate-200 hover:border-blue-500 rounded-2xl cursor-pointer transition">
                                <div class="flex items-center gap-3">
                                    <input type="radio" name="paymentMethod" value="truemoney" class="accent-blue-600">
                                    <span class="font-extrabold text-xs text-slate-900">TrueMoney Wallet</span>
                                </div>
                                <span class="text-xs text-slate-500 font-bold">🧡 E-Wallet</span>
                            </label>
                        </div>

                        <div class="pt-2">
                            <button onclick="executeFinalPayment()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-4 rounded-2xl shadow-xl transition text-base uppercase tracking-wider flex justify-center items-center gap-2">
                                <span>🔒 Pay & Complete Booking</span>
                            </button>
                        </div>
                    </div>

                </div>

            </div>

            <!-- RIGHT STICKY PRICE BREAKDOWN SIDEBAR (Matching Trip.com Sidebar) -->
            <aside class="lg:col-span-4 sticky top-24 space-y-4">
                <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-lg space-y-4">
                    <h3 class="font-extrabold text-sm text-slate-900 border-b border-slate-100 pb-3">Price details</h3>

                    <div class="space-y-2.5 text-xs text-slate-600">
                        <div class="flex justify-between items-center">
                            <span>Tickets (<%= passengers.filter(passenger => passenger.seatRequired).length %> passenger<%= passengers.filter(passenger => passenger.seatRequired).length === 1 ? '' : 's' %>)</span>
                            <span class="font-bold text-slate-900">฿ <span id="baseTicketPrice"><%= (bookingInfo.basePrice * passengers.filter(passenger => passenger.seatRequired).length).toLocaleString() %></span></span>
                        </div>

                        <!-- Baggage Info -->
                        <div class="border-t border-slate-100 pt-2 space-y-1">
                            <span class="font-extrabold text-slate-800 block">Baggage</span>
                            <div class="flex justify-between text-[11px]">
                                <span class="text-slate-500">Personal item</span>
                                <span class="text-emerald-600 font-bold">Free</span>
                            </div>
                            <div class="flex justify-between text-[11px]">
                                <span class="text-slate-500">Carry-on baggage</span>
                                <span class="text-emerald-600 font-bold">Free</span>
                            </div>
                            <div class="flex justify-between text-[11px]">
                                <span class="text-slate-500">Checked baggage</span>
                                <span id="baggagePriceText" class="<%= bookingInfo.baggageIncluded ? 'text-emerald-600 font-bold' : 'text-slate-400 font-medium' %>"><%= bookingInfo.baggageIncluded ? 'Included · 15 kg' : 'Not included' %></span>
                            </div>
                        </div>

                        <!-- Add-ons Info -->
                        <div class="border-t border-slate-100 pt-2 space-y-1">
                            <span class="font-extrabold text-slate-800 block">Add-ons</span>
                            <div id="fareAddonRow" class="flex justify-between text-[11px] <%= bookingInfo.fareAddonPrice ? '' : 'hidden' %>">
                                <span class="text-slate-500"><%= bookingInfo.fareAddonLabel %></span>
                                <span class="font-bold text-slate-900">฿ <%= (bookingInfo.fareAddonPrice * passengers.filter(passenger => passenger.seatRequired).length).toLocaleString() %></span>
                            </div>
                            <div id="seatPriceRow" class="flex justify-between text-[11px] hidden">
                                <span class="text-slate-500">Selected Seat (<span id="seatNameLabel">-</span>)</span>
                                <span class="font-bold text-slate-900">฿ <span id="seatPriceVal">0</span></span>
                            </div>
                            <div id="carbonOffsetRow" class="flex justify-between text-[11px] hidden text-emerald-700 font-bold">
                                <span>Green Carbon Offset</span>
                                <span>฿ 50</span>
                            </div>
                        </div>

                        <!-- Promo discount row -->
                        <div id="promoRow" class="flex justify-between text-[11px] text-rose-600 font-bold border-t border-slate-100 pt-2 hidden">
                            <span>Promo Discount</span>
                            <span>- ฿ 200</span>
                        </div>
                    </div>

                    <div class="border-t border-slate-200 pt-4 flex justify-between items-end">
                        <div>
                            <span class="text-[11px] font-bold text-slate-400 block uppercase">Total</span>
                            <span class="text-2xl font-black text-blue-600">฿ <span id="totalPriceVal">3,550</span></span>
                        </div>
                        <span class="bg-amber-100 text-amber-800 text-[10px] font-extrabold px-2.5 py-1 rounded-full border border-amber-300">
                            🪙 +22 Trip Coins
                        </span>
                    </div>
                </div>
            </aside>

        </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer') %>

    <!-- SCRIPT FOR CHECKOUT INTERACTION -->
    <script>
        let currentStep = 1;
        const seatRequiredCount = <%= passengers.filter(passenger => passenger.seatRequired).length %>;
        let baseTicket = <%= bookingInfo.basePrice %> * seatRequiredCount;
        let fareAddon = <%= bookingInfo.fareAddonPrice %> * seatRequiredCount;
        let baggageIncluded = <%= bookingInfo.baggageIncluded ? 'true' : 'false' %>;
        let baggageFee = 0;
        let seatFee = 0;
        let carbonFee = 0;
        let promoDiscount = 0;
        const selectedSeats = new Map();
        const occupiedSeats = new Set(['1E', '2D', '4F', '5A']);
        const seatLetters = ['A', 'B', 'C', 'D', 'E', 'F'];

        function renderSeatMap() {
            const seatRows = document.getElementById('seatRows');
            seatRows.innerHTML = Array.from({ length: 6 }, (_, rowIndex) => {
                const rowNumber = rowIndex + 1;
                const rowPrice = rowNumber === 1 ? 250 : 0;
                const seats = seatLetters.map(letter => {
                    const seatName = `${rowNumber}${letter}`;
                    const isOccupied = occupiedSeats.has(seatName);
                    const isSelected = selectedSeats.has(seatName);
                    const className = isOccupied
                        ? 'bg-slate-400 text-white cursor-not-allowed'
                        : isSelected
                            ? 'bg-blue-600 text-white ring-2 ring-blue-300'
                            : rowPrice
                                ? 'bg-emerald-500 hover:bg-emerald-600 text-white'
                                : 'bg-slate-200 hover:bg-slate-300 text-slate-800';

                    return `<button type="button" data-seat="${seatName}" data-price="${rowPrice}" aria-pressed="${isSelected}" aria-label="${seatName}${isOccupied ? ', occupied' : rowPrice ? ', extra legroom, 250 baht' : ', standard seat'}" ${isOccupied ? 'disabled' : ''} class="h-10 rounded-lg font-bold text-xs transition ${className} disabled:opacity-40">${seatName}</button>`;
                });
                const seatCells = [...seats.slice(0, 3), `<span class="flex items-center justify-center text-[10px] text-slate-400 font-bold">R${rowNumber}</span>`, ...seats.slice(3)];
                return `<div class="grid grid-cols-[repeat(3,minmax(0,1fr))_1.5rem_repeat(3,minmax(0,1fr))] gap-2">${seatCells.join('')}</div>`;
            }).join('');

            seatRows.querySelectorAll('[data-seat]:not(:disabled)').forEach(button => {
                const seatName = button.dataset.seat;
                const price = Number(button.dataset.price);
                button.disabled = !selectedSeats.has(seatName)
                    && selectedSeats.size >= seatRequiredCount;
                button.addEventListener('click', () => toggleSeat(seatName, price));
            });
        }

        function updateSeatSelection() {
            const selectedSeatNames = [...selectedSeats.keys()];
            seatFee = [...selectedSeats.values()].reduce((total, price) => total + price, 0);
            document.getElementById('selectedSeatBadge').innerText =
                `${selectedSeats.size} / ${seatRequiredCount}`;
            document.getElementById('seatNameLabel').innerText =
                selectedSeatNames.length ? selectedSeatNames.join(', ') : '-';
            document.getElementById('seatPriceVal').innerText = seatFee.toLocaleString();
            document.getElementById('seatPriceRow').classList.toggle('hidden', selectedSeats.size === 0);
            document.getElementById('continueToPaymentBtn').disabled =
                selectedSeats.size !== seatRequiredCount;

            const remainingSeats = seatRequiredCount - selectedSeats.size;
            document.getElementById('seatSelectionMessage').innerText = remainingSeats
                ? `Selected ${selectedSeats.size} of ${seatRequiredCount} seats. Choose ${remainingSeats} more to continue.`
                : `All ${seatRequiredCount} passenger seats selected. You can click a selected seat to change it.`;
            renderSeatMap();
            updateTotalPrice();
        }

        function toggleSeat(seatName, price) {
            if (selectedSeats.has(seatName)) {
                selectedSeats.delete(seatName);
            } else if (selectedSeats.size < seatRequiredCount) {
                selectedSeats.set(seatName, price);
            }
            updateSeatSelection();
        }

        function updateTotalPrice() {
            const total = baseTicket + fareAddon + baggageFee + seatFee + carbonFee - promoDiscount;
            document.getElementById('totalPriceVal').innerText = total.toLocaleString();
        }

        function switchStep(stepNum) {
            if (stepNum === 3 && selectedSeats.size !== seatRequiredCount) {
                document.getElementById('seatSelectionMessage').innerText =
                    `Please select ${seatRequiredCount} seats before continuing to payment.`;
                document.getElementById('seatSelectionMessage').classList.add('text-rose-600');
                return;
            }
            document.getElementById('seatSelectionMessage').classList.remove('text-rose-600');
            currentStep = stepNum;

            // Toggle active Step Sections
            document.getElementById('stepSection1').classList.toggle('hidden', stepNum !== 1);
            document.getElementById('stepSection2').classList.toggle('hidden', stepNum !== 2);
            document.getElementById('stepSection3').classList.toggle('hidden', stepNum !== 3);

            // Update Stepper Header Styles
            [1, 2, 3].forEach(i => {
                const header = document.getElementById(`stepHeader${i}`);
                if (i === stepNum) {
                    header.className = "flex items-center gap-2 text-blue-600 border-b-2 border-blue-600 pb-1 cursor-pointer font-bold";
                } else {
                    header.className = "flex items-center gap-2 text-slate-400 pb-1 cursor-pointer font-medium";
                }
            });

            window.scrollTo({ top: 100, behavior: 'smooth' });
        }

        function toggleBaggageAddon() {
            if (baggageIncluded) return;
            const btn = document.getElementById('baggageToggleBtn');
            if (baggageFee === 0) {
                baggageFee = 450;
                btn.innerText = "✓ Added ฿450";
                btn.className = "px-4 py-2 bg-emerald-600 text-white font-bold rounded-xl transition";
                document.getElementById('baggagePriceText').innerText = "฿ 450 (15 kg)";
                document.getElementById('baggagePriceText').className = "text-emerald-700 font-bold";
            } else {
                baggageFee = 0;
                btn.innerText = "+ Add ฿450";
                btn.className = "px-4 py-2 bg-blue-50 text-blue-600 font-bold rounded-xl border border-blue-200 hover:bg-blue-600 hover:text-white transition";
                document.getElementById('baggagePriceText').innerText = "Not included";
                document.getElementById('baggagePriceText').className = "text-slate-400 font-medium";
            }
            updateTotalPrice();
        }

        function toggleCarbonOffset() {
            const check = document.getElementById('carbonOffsetCheck').checked;
            carbonFee = check ? 50 : 0;
            document.getElementById('carbonOffsetRow').classList.toggle('hidden', !check);
            updateTotalPrice();
        }

        function applyPromoCode() {
            const input = document.getElementById('promoInput').value.trim();
            if (input) {
                promoDiscount = 200;
                document.getElementById('promoRow').classList.remove('hidden');
                alert("🎉 Promo code applied successfully! ฿200 Discount");
                updateTotalPrice();
            }
        }

        function executeFinalPayment() {
            alert("🎉 Booking & Payment Successful!\nYour e-ticket and receipt have been sent to john.doe@example.com");
            window.location.href = "/flights";
        }

        // Initialize Price Calculation
        updateSeatSelection();
        updateTotalPrice();
    </script>
</body>
</html>