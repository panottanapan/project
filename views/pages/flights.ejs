<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <!-- Hero Section -->
    <div class="relative bg-emerald-950 text-white pt-10 pb-20 px-4 sm:px-6 lg:px-8">
        <div class="absolute inset-0 opacity-20 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=1600&q=80');"></div>
        
        <div class="max-w-6xl mx-auto relative z-10 space-y-6 text-center md:text-left">
            <div class="inline-flex items-center gap-2 bg-emerald-800/80 border border-emerald-600/50 px-3 py-1 rounded-full text-xs text-emerald-200">
                <span>🌱 Sustainable Tourism Thailand</span>
            </div>
            <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight">
                Sustainable Eco-Flights & Experiences in Thailand<span class="text-emerald-400">.</span>
            </h1>

            <!-- Search Bar Box (Matching Hotel Emerald Theme) -->
            <div class="bg-white p-4 md:p-5 rounded-2xl shadow-xl text-slate-800 border border-slate-100 mt-6">
                <form action="/flights/search" method="GET" class="grid grid-cols-1 lg:grid-cols-12 gap-3 items-center">
                    
                    <!-- 1. FLYING FROM -->
                    <div class="min-w-0 lg:col-span-2 text-left border-b lg:border-b-0 lg:border-r border-slate-200 pb-2 lg:pb-0 lg:pr-3">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Flying From</label>
                        <select name="origin" id="originSelect" onchange="reloadPageRoute()" class="w-full min-w-0 text-xs md:text-sm font-bold bg-transparent outline-none mt-1 text-slate-900 cursor-pointer">
                            <% availableCities.forEach(city => { %>
                                <option value="<%= city %>" <%= selectedOrigin === city ? 'selected' : '' %>>
                                    <%= city %>, Thailand
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- 2. SELECT DESTINATION -->
                    <div class="min-w-0 lg:col-span-2 text-left border-b lg:border-b-0 lg:border-r border-slate-200 pb-2 lg:pb-0 lg:pr-3">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Select Destination</label>
                        <select name="destination" id="destSelect" onchange="reloadPageRoute()" class="w-full min-w-0 text-xs md:text-sm font-bold bg-transparent outline-none mt-1 text-emerald-900 cursor-pointer">
                            <% availableCities.forEach(city => { %>
                                <option value="<%= city %>" <%= selectedDestination === city ? 'selected' : '' %>>
                                    <%= city %>, Thailand
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- 3. DATES -->
                    <div class="min-w-0 lg:col-span-3 text-left border-b lg:border-b-0 lg:border-r border-slate-200 pb-2 lg:pb-0 lg:pr-3">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Dates</label>
                        <div class="grid grid-cols-2 gap-2 mt-1">
                            <label class="block min-w-0">
                                <span class="block text-[9px] font-semibold text-slate-400">Depart</span>
                                <input type="date" name="departDate" id="departDate" required class="w-full min-w-0 text-xs font-semibold bg-transparent outline-none text-slate-800 cursor-pointer">
                            </label>
                            <label class="block min-w-0">
                                <span class="block text-[9px] font-semibold text-slate-400">Return</span>
                                <input type="date" name="returnDate" id="returnDate" required class="w-full min-w-0 text-xs font-semibold bg-transparent outline-none text-slate-800 cursor-pointer">
                            </label>
                        </div>
                    </div>

                    <!-- 4. GUESTS & CLASS -->
                    <div class="min-w-0 lg:col-span-3 text-left border-b lg:border-b-0 lg:border-r border-slate-200 pb-2 lg:pb-0 lg:pr-3">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Passengers · Economy</label>
                        <input type="hidden" name="adults" id="adultsInput" value="1">
                        <input type="hidden" name="children" id="childrenInput" value="0">
                        <input type="hidden" name="lapInfants" id="lapInfantsInput" value="0">
                        <div class="grid grid-cols-3 gap-1.5 mt-1">
                            <div class="min-w-0">
                                <p class="block truncate text-[8px] font-bold text-slate-600" title="Adults, age 12 and over">Adults</p>
                                <div class="flex items-center justify-between gap-0.5 mt-1">
                                    <button type="button" data-passenger="adults" data-step="-1" aria-label="Decrease adults" class="w-5 h-5 rounded-full border border-slate-300 text-slate-700 disabled:opacity-40">−</button>
                                    <span id="adultsCount" class="w-4 text-center text-xs font-bold">1</span>
                                    <button type="button" data-passenger="adults" data-step="1" aria-label="Increase adults" class="w-5 h-5 rounded-full border border-slate-300 text-slate-700 disabled:opacity-40">+</button>
                                </div>
                            </div>
                            <div class="min-w-0">
                                <p class="block truncate text-[8px] font-bold text-slate-600" title="Children, ages 2–11">Children</p>
                                <div class="flex items-center justify-between gap-0.5 mt-1">
                                    <button type="button" data-passenger="children" data-step="-1" aria-label="Decrease children" class="w-5 h-5 rounded-full border border-slate-300 text-slate-700 disabled:opacity-40">−</button>
                                    <span id="childrenCount" class="w-4 text-center text-xs font-bold">0</span>
                                    <button type="button" data-passenger="children" data-step="1" aria-label="Increase children" class="w-5 h-5 rounded-full border border-slate-300 text-slate-700 disabled:opacity-40">+</button>
                                </div>
                            </div>
                            <div class="min-w-0">
                                <p class="block truncate text-[8px] font-bold text-slate-600" title="Infants under 2, seated on an adult's lap">Lap infants</p>
                                <div class="flex items-center justify-between gap-0.5 mt-1">
                                    <button type="button" data-passenger="lapInfants" data-step="-1" aria-label="Decrease lap infants" class="w-5 h-5 rounded-full border border-slate-300 text-slate-700 disabled:opacity-40">−</button>
                                    <span id="lapInfantsCount" class="w-4 text-center text-xs font-bold">0</span>
                                    <button type="button" data-passenger="lapInfants" data-step="1" aria-label="Increase lap infants" class="w-5 h-5 rounded-full border border-slate-300 text-slate-700 disabled:opacity-40">+</button>
                                </div>
                            </div>
                        </div>
                        <p id="passengerLimitMessage" aria-live="polite" class="text-[9px] text-slate-500 mt-1">Maximum 9 passengers total</p>
                    </div>

                    <!-- 5. SEARCH BUTTON -->
                    <div class="lg:col-span-2 flex items-center">
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold p-3.5 rounded-xl transition duration-200 shadow-md flex justify-center items-center gap-1.5 text-xs uppercase tracking-wider">
                            <span>🔍</span> Search Flights
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20 space-y-12">

        <!-- Trip Savings Banner -->
        <div class="bg-white p-4 md:p-5 rounded-2xl border border-emerald-200 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-emerald-100 text-emerald-800 rounded-xl flex items-center justify-center text-2xl font-bold">
                    ✈️
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="bg-emerald-700 text-white text-[10px] font-bold px-2 py-0.5 rounded">Green Travel Savings</span>
                        <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-300"><%= cityData.savingBadge %></span>
                    </div>
                    <h3 class="font-bold text-sm text-slate-900 mt-1">Book Flights to <%= cityData.name %></h3>
                    <p class="text-xs text-slate-500">Calculated CO₂ emissions with Google TIM API • No hidden fees</p>
                </div>
            </div>
            <div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-end border-t md:border-t-0 pt-3 md:pt-0">
                <div class="text-right">
                    <span class="text-[10px] text-slate-400 block font-semibold">From</span>
                    <span class="text-base font-extrabold text-emerald-800">฿<%= cityData.priceFrom.toLocaleString() %></span>
                </div>
                <a href="/flights/search?origin=<%= selectedOrigin %>&destination=<%= cityData.name %>" class="bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-bold px-5 py-2.5 rounded-xl transition shadow">
                    Search flights &gt;
                </a>
            </div>
        </div>

        <!-- Eco Activities Section -->
        <section class="space-y-5">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end border-b border-slate-200 pb-3">
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-xl md:text-2xl font-bold text-slate-900">Top eco-things to do in <%= cityData.name %></h2>
                        <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-300">Sustainable Tours</span>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">Verified low-carbon attractions, local culture & nature activities</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <% cityData.activities.forEach(act => { %>
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition overflow-hidden flex flex-col justify-between">
                        <div>
                            <div class="relative h-40 overflow-hidden">
                                <img src="<%= act.img %>" alt="<%= act.title %>" class="w-full h-full object-cover">
                                <span class="absolute top-2.5 left-2.5 bg-emerald-900/90 text-emerald-200 text-[10px] font-bold px-2.5 py-0.5 rounded-full">
                                    <%= act.tag %>
                                </span>
                            </div>

                            <div class="p-4 space-y-2">
                                <div class="flex items-center gap-1 text-[11px] text-amber-600 font-bold">
                                    <span>★ <%= act.rating %></span>
                                    <span class="text-slate-400 font-normal">(<%= act.reviews %> booked)</span>
                                </div>
                                <h3 class="font-bold text-xs text-slate-900 line-clamp-2 leading-snug"><%= act.title %></h3>
                                <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded w-fit block font-medium">
                                    ⚡ Free cancellation
                                </span>
                            </div>
                        </div>

                        <div class="p-4 border-t border-slate-100 flex justify-between items-center bg-slate-50/50">
                            <span class="text-[10px] text-slate-400 font-semibold"><%= act.category %></span>
                            <div class="text-right">
                                <span class="text-[10px] text-slate-400 block font-normal">From</span>
                                <span class="text-base font-extrabold text-slate-900">฿<%= act.priceTHB.toLocaleString() %></span>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>

        <!-- Recommended Flights Section -->
        <section class="space-y-6">
            <div class="flex justify-between items-end border-b border-slate-200 pb-3">
                <div>
                    <h2 class="text-xl font-bold text-slate-900">Recommended low-carbon flights to <%= cityData.name %></h2>
                    <p class="text-xs text-slate-500 mt-1">Verified low-emission airline routes calculated via Google TIM API</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <% cityData.flights.forEach(f => { %>
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition overflow-hidden flex flex-col justify-between">
                        <div>
                            <div class="p-4 bg-slate-900 text-white flex justify-between items-center">
                                <div class="flex items-center gap-2">
                                    <span class="text-lg"><%= f.logo %></span>
                                    <div>
                                        <h4 class="font-extrabold text-xs text-white"><%= f.airline %></h4>
                                        <p class="text-[10px] text-slate-400"><%= f.code %></p>
                                    </div>
                                </div>
                                <span class="bg-gradient-to-r from-emerald-600 to-teal-600 text-white text-[10px] font-black px-2.5 py-0.5 rounded-full">
                                    🌱 <%= f.ecoBadge %>
                                </span>
                            </div>

                            <div class="p-4 space-y-3">
                                <div class="flex items-center justify-between text-xs font-bold text-slate-800">
                                    <span><%= f.route %></span>
                                    <span class="text-slate-400 font-normal text-[11px]"><%= f.duration %></span>
                                </div>

                                <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100 flex justify-between items-center text-xs">
                                    <div>
                                        <span class="text-[10px] text-slate-400 block">Departure</span>
                                        <strong class="text-slate-900"><%= f.depTime %></strong>
                                    </div>
                                    <span class="text-slate-300">➔</span>
                                    <div>
                                        <span class="text-[10px] text-slate-400 block">Arrival</span>
                                        <strong class="text-slate-900"><%= f.arrTime %></strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="p-4 border-t border-slate-100 flex justify-between items-center bg-slate-50/50">
                            <span class="text-[10px] text-slate-400 font-semibold">One-way from</span>
                            <div class="text-right">
                                <span class="text-lg font-extrabold text-slate-900">฿<%= f.priceTHB.toLocaleString() %></span>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>

    </main>

    <!-- Script to dynamically reload page content when Origin or Destination is changed -->
    <script>
        const departureInput = document.getElementById('departDate');
        const returnInput = document.getElementById('returnDate');
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);
        const toDateValue = date => {
            const localDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
            return localDate.toISOString().slice(0, 10);
        };
        const todayValue = toDateValue(today);
        departureInput.min = todayValue;
        returnInput.min = todayValue;
        departureInput.value = '<%= typeof selectedDepartDate !== "undefined" ? selectedDepartDate : "" %>' || todayValue;
        returnInput.value = '<%= typeof selectedReturnDate !== "undefined" ? selectedReturnDate : "" %>' || toDateValue(tomorrow);
        returnInput.min = departureInput.value || todayValue;
        if (returnInput.value < returnInput.min) returnInput.value = returnInput.min;
        departureInput.addEventListener('change', () => {
            returnInput.min = departureInput.value || todayValue;
            if (returnInput.value && returnInput.value < returnInput.min) {
                returnInput.value = returnInput.min;
            }
        });

        const passengerTypes = ['adults', 'children', 'lapInfants'];
        const passengerValues = {
            adults: Number('<%= typeof selectedAdults !== "undefined" ? selectedAdults : 1 %>'),
            children: Number('<%= typeof selectedChildren !== "undefined" ? selectedChildren : 0 %>'),
            lapInfants: Number('<%= typeof selectedLapInfants !== "undefined" ? selectedLapInfants : 0 %>')
        };
        const totalPassengers = () => passengerTypes.reduce((total, type) => total + passengerValues[type], 0);
        const updatePassengerCounts = () => {
            passengerTypes.forEach(type => {
                document.getElementById(`${type}Input`).value = passengerValues[type];
                document.getElementById(`${type}Count`).textContent = passengerValues[type];
            });
            const total = totalPassengers();
            document.querySelectorAll('[data-passenger]').forEach(button => {
                const type = button.dataset.passenger;
                const step = Number(button.dataset.step);
                button.disabled = step < 0
                    ? passengerValues[type] <= (type === 'adults' ? 1 : 0)
                    : total >= 9;
            });
            document.getElementById('passengerLimitMessage').textContent =
                `${total} of 9 passengers selected`;
        };

        document.querySelectorAll('[data-passenger]').forEach(button => {
            button.addEventListener('click', () => {
                const type = button.dataset.passenger;
                const nextValue = passengerValues[type] + Number(button.dataset.step);
                if (nextValue < (type === 'adults' ? 1 : 0) || nextValue > 9) return;
                if (button.dataset.step === '1' && totalPassengers() >= 9) return;
                passengerValues[type] = nextValue;
                updatePassengerCounts();
            });
        });
        updatePassengerCounts();

        function reloadPageRoute() {
            const originVal = document.getElementById('originSelect').value;
            const destVal = document.getElementById('destSelect').value;
            const params = new URLSearchParams({
                origin: originVal,
                destination: destVal,
                departDate: departureInput.value,
                returnDate: returnInput.value,
                adults: passengerValues.adults,
                children: passengerValues.children,
                lapInfants: passengerValues.lapInfants
            });
            window.location.href = `/flights?${params.toString()}`;
        }
    </script>

    <!-- Footer -->
    <%- include('../partials/footer') %>

</body>
</html>